{
  "appId": "com.local.github-ci-notify",
  "productName": "GitHub CI Notify",
  "mac": {
    "target": "dmg",
    "category": "public.app-category.developer-tools",
    "extendInfo": {
      "NSUserNotificationAlertStyle": "alert"
    }
